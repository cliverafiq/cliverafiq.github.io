---
import { stops } from '../data/stops';
import type { StopId } from '../data/types';

interface Props {
  usedAt: StopId[];
}

const { usedAt } = Astro.props;
const label = `Used in ${stops.filter(stop => usedAt.includes(stop.id)).map(stop => stop.city).join(', ')}`;
---
<span class="mini-route" role="img" aria-label={label}>
  {stops.map(stop => <span class="mini-dot" data-used={usedAt.includes(stop.id) ? '' : undefined}></span>)}
</span>

<style>
  .mini-route {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    width: 96px;
  }
  .mini-route::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 4px;
    right: 4px;
    height: 2px;
    margin-top: -1px;
    background: var(--track);
  }
  .mini-dot {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--track);
    background: var(--page);
  }
  .mini-dot[data-used] {
    border-color: var(--route);
    background: var(--route);
  }
</style>
