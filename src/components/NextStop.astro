---
import { profile } from '../data/profile';
---
<section id="contact" class="next-stop" aria-labelledby="contact-title">
  <span class="dot dashed" aria-hidden="true"></span>
  <h2 id="contact-title">Next: 2027 internship</h2>
  <ul class="contact-links">
    <li><a href={`mailto:${profile.email}`}>Email</a></li>
    <li><a href={profile.linkedin}>LinkedIn</a></li>
    <li><a href={profile.github}>GitHub</a></li>
    <li><a href={profile.resumePath}>Resume</a></li>
  </ul>
</section>

<style>
  /* The route continues, dashed, to the stop that hasn't happened yet. */
  .next-stop {
    position: relative;
    padding: 72px 0 112px 44px;
  }
  .next-stop::before {
    content: '';
    position: absolute;
    top: 0;
    left: 7px;
    height: 85px;
    border-left: 3px dashed var(--route);
  }
  .dot {
    position: absolute;
    top: 85px;
    left: 0;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    border: 2px dashed var(--route);
    background: var(--page);
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
