---
import { profile } from '../data/profile';
---
<nav class="topbar" aria-label="Site">
  <a class="home" href="#top">{profile.name}</a>
  <a href={profile.resumePath}>Resume</a>
  <a href={profile.github}>GitHub</a>
  <a href={`mailto:${profile.email}`}>Email</a>
</nav>
<style>
  .topbar {
    position: sticky; top: 0; z-index: 20; height: var(--bar); box-sizing: border-box; display: flex; align-items: center; gap: 22px;
    /* The bar runs edge to edge, but its contents line up with the page column (--page-max and --pad in global.css). */
    padding-left: calc(max(0px, (100% - var(--page-max)) / 2) + max(var(--pad), env(safe-area-inset-left, 0px)));
    padding-right: calc(max(0px, (100% - var(--page-max)) / 2) + max(var(--pad), env(safe-area-inset-right, 0px)));
    background: var(--page); border-bottom: 1px solid var(--hairline); font: 500 15px 'Geist', system-ui, sans-serif;
  }
  .topbar a { color: var(--ink); text-decoration: none; white-space: nowrap; padding-block: 10px; }
  .topbar a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .topbar .home { margin-right: auto; font: 800 18px 'Bricolage Grotesque', system-ui, sans-serif; letter-spacing: -0.02em; }
  @media (max-width: 420px) {
    .topbar { gap: 12px; font-size: 14px; }
    .topbar .home { font-size: 17px; }
  }
</style>
