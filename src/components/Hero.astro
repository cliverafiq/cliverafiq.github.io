---
import { profile } from '../data/profile';
---
<header id="top" class="hero" data-hero>
  <h1>{profile.name}</h1>
  <p class="headline">{profile.headline}</p>
  <p class="line">{profile.line}</p>
  <p class="hero-links">
    <a class="button primary" href={profile.resumePath}>Resume</a>
    <a class="button" href={profile.github}>GitHub</a>
  </p>
</header>
<style>
  .hero { display: flex; flex-direction: column; justify-content: center; padding: 48px 0 40px; }
  h1 { margin: 0; font: 800 52px/.92 'Bricolage Grotesque', system-ui, sans-serif; letter-spacing: -0.04em; color: var(--ink); }
  .headline { margin: 24px 0 0; font: 500 24px/1.2 'Bricolage Grotesque', system-ui, sans-serif; color: var(--ink); text-wrap: balance; max-width: 34ch; }
  .line { margin: 18px 0 0; font: 400 17px/1.55 'Geist', system-ui, sans-serif; color: var(--muted); max-width: 52ch; }
  .hero-links { margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 12px; }
  @media (min-width: 900px) {
    .hero { min-height: calc(100vh - 64px); }
    h1 { font-size: 88px; }
    .headline { font-size: 34px; margin-top: 32px; }
  }
</style>
