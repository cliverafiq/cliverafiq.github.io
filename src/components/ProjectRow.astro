---
import { stopById } from '../data/stops';
import type { Project } from '../data/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const stop = stopById(project.stop);
---
<article class="project" id={`project-${project.slug}`}>
  <p class="marker"><span class="city">{stop.city}</span> <span class="date">{project.date}</span></p>
  {project.image ? (
    <figure class="shot">
      <img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" decoding="async" />
    </figure>
  ) : project.figure && (
    <p class="figure"><span class="value">{project.figure.value}</span> <span class="label">{project.figure.label}</span></p>
  )}
  <div class="body">
    <h3>{project.name}</h3>
    <p class="summary">{project.summary}</p>
    <p class="part">My part: {project.part}</p>
    <p class="stack">{project.stack.join(', ')}</p>
    <div class="outcome">
      <p class="result">{project.result}</p>
      <p class="links">{project.links.map(link => <a href={link.href}>{link.label}</a>)}</p>
    </div>
  </div>
</article>

<style>
  /* Lives on the dark band: light text, the lighter route color, and rules mixed from the two. */
  .project {
    --rule: color-mix(in srgb, var(--page) 16%, var(--ink));
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) 270px;
    grid-template-areas: 'marker body figure';
    column-gap: 32px;
    padding-block: 40px;
    border-top: 1px solid var(--rule);
  }
  .marker { grid-area: marker; }
  .body { grid-area: body; }
  .figure, .shot { grid-area: figure; }
  .marker {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-left: 28px;
    font-size: var(--t-label);
    color: var(--mutedOnDark);
  }
  .marker::before {
    content: '';
    position: absolute;
    top: 9px;
    left: 7px;
    width: 4px;
    height: 56px;
    border-radius: 2px;
    background: var(--routeOnDark);
  }
  .marker::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 4px solid var(--routeOnDark);
    background: var(--ink);
  }
  .city {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--page);
  }
  .figure {
    text-align: right;
  }
  .shot {
    margin: 0;
  }
  .shot img {
    display: block;
    width: 100%;
    max-width: 394px;
    height: auto;
    margin-left: auto;
    border-radius: 8px;
  }
  .value {
    display: block;
    white-space: nowrap;
    font-size: 64px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--routeOnDark);
  }
  .label {
    display: block;
    margin-top: 10px;
    font-size: var(--t-label);
    color: var(--mutedOnDark);
  }
  h3 {
    font-size: 32px;
    letter-spacing: -0.01em;
    color: var(--page);
  }
  .summary {
    margin-top: 8px;
    color: var(--mutedOnDark);
  }
  .part {
    margin-top: 12px;
    color: var(--page);
  }
  .stack {
    margin-top: 12px;
    font-size: var(--t-label);
    color: var(--mutedOnDark);
  }
  .outcome {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    max-width: 70ch;
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    color: var(--page);
  }
  .links {
    display: flex;
    gap: 20px;
    font-size: var(--t-small);
  }
  .links a {
    color: var(--routeOnDark);
  }
  @media (max-width: 960px) {
    .project {
      grid-template-columns: 132px minmax(0, 1fr);
      grid-template-areas: 'marker figure' 'marker body';
      row-gap: 20px;
    }
    .figure { text-align: left; }
    .shot img { margin-left: 0; }
  }
  @media (max-width: 640px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'marker' 'figure' 'body';
      row-gap: 16px;
    }
    .marker { flex-direction: row; gap: 8px; }
    .marker::before { display: none; }
    .value { font-size: 48px; }
  }
</style>
