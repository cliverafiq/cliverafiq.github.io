---
import type { WorkEntry } from '../data/types';
import { layerById } from '../data/layers';

interface Props { entry: WorkEntry }
const { entry } = Astro.props;
const tags = entry.layers.map(layerById);
---
<article class="entry" id={`entry-${entry.slug}`} data-entry data-layers={entry.layers.join(' ')}>
  <h3>{entry.name}</h3>
  <p class="meta"><span class="role">{entry.role}</span>, <span class="dates">{entry.dates}</span></p>
  {entry.text && <p class="text">{entry.text}</p>}
  {entry.highlight && (
    <p class="highlight"><span class="value">{entry.highlight.value}</span> <span class="label">{entry.highlight.label}</span></p>
  )}
  {entry.award && <p class="award">{entry.award}</p>}
  {entry.image && (
    <figure class="shot">
      <img src={entry.image.src} alt={entry.image.alt} width={entry.image.width} height={entry.image.height} loading="lazy" />
    </figure>
  )}
  <ul class="tags" aria-label="Layers">
    {tags.map(l => <li style={`--c:${l.color};--t:${l.text}`}>{l.name}</li>)}
  </ul>
  {entry.links.length > 0 && (
    <p class="links">{entry.links.map(l => <a href={l.href}>{l.label}</a>)}</p>
  )}
</article>

<style>
  .entry { padding-block: 64px; }
  @media (min-width: 900px) { .entry { min-height: 60vh; } }
  h3 {
    margin: 0;
    font: 800 34px/1.05 'Bricolage Grotesque', system-ui, sans-serif;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .meta { margin: 8px 0 0; font: 400 15px/1.4 'Geist', system-ui, sans-serif; color: var(--muted); }
  .text { margin: 20px 0 0; max-width: 60ch; font: 400 17px/1.55 'Geist', system-ui, sans-serif; }
  .highlight { margin: 24px 0 0; display: flex; align-items: baseline; gap: 12px; }
  .value {
    font: 800 64px/1 'Bricolage Grotesque', system-ui, sans-serif;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .label { font: 400 15px/1.4 'Geist', system-ui, sans-serif; color: var(--muted); }
  .award {
    margin: 24px 0 0;
    display: inline-block;
    padding: 6px 14px;
    border-radius: 99px;
    background: #DFFF4F;
    color: #141600;
    font: 800 15px/1.2 'Bricolage Grotesque', system-ui, sans-serif;
  }
  .shot { margin: 24px 0 0; }
  .shot img { display: block; max-width: 100%; height: auto; border-radius: 12px; }
  .tags { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li {
    padding: 4px 9px;
    border-radius: 99px;
    background: var(--c);
    color: var(--t);
    font: 500 12px/1.3 'Geist Mono', ui-monospace, monospace;
  }
  .links { margin: 20px 0 0; display: flex; gap: 20px; font: 500 15px/1.4 'Geist', system-ui, sans-serif; }
  .links a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
</style>
