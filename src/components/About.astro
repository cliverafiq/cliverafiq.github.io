---
import { profile } from '../data/profile';
---
<section id="about" class="about" aria-labelledby="about-title">
  <h2 id="about-title" class="visually-hidden">About</h2>
  {profile.about.map(paragraph => <p>{paragraph}</p>)}
</section>

<style>
  .about {
    padding-block: 8px 40px;
  }
  p {
    max-width: 60ch;
  }
  p + p {
    margin-top: 12px;
  }
</style>
