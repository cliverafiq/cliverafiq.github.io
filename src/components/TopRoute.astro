---
import type { Stop } from '../data/types';

interface Props {
  stops: Stop[];
}

const { stops } = Astro.props;
---
<ol class="top-route" style={`--n:${stops.length}`}>
  {stops.map((stop, i) => (
    <li style={`--i:${i}`}>
      <a href={`#stop-${stop.id}`}>
        <span class="dot" aria-hidden="true"></span>
        <span class="city">{stop.city}</span>
        <span class="years">{stop.years}</span>
        <span class="win">{stop.win}</span>
      </a>
    </li>
  ))}
</ol>

<style>
  .top-route {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The line runs from the first dot's center to the last dot's center. */
  .top-route::before {
    content: '';
    position: absolute;
    top: 7px;
    left: calc(100% / var(--n) / 2);
    right: calc(100% / var(--n) / 2);
    height: 3px;
    background: var(--route);
    transform-origin: left center;
    animation: route-draw 1s ease-out both;
  }
  li {
    position: relative;
    text-align: center;
    animation: stop-in 300ms ease-out both;
    animation-delay: calc(150ms + var(--i) * 200ms);
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: 8px;
    color: var(--ink);
    text-decoration: none;
  }
  .dot {
    position: relative;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--page);
    border: 3px solid var(--route);
  }
  .city {
    margin-top: 12px;
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .years {
    font-size: var(--t-label);
    color: var(--muted);
  }
  .win {
    margin-top: 6px;
    font-size: var(--t-small);
    line-height: 1.4;
  }
  a:hover .win {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  @media (max-width: 640px) {
    .years, .win { display: none; }
  }
  @keyframes route-draw {
    from { transform: scaleX(0); }
  }
  @keyframes stop-in {
    from { opacity: 0; }
  }
</style>
