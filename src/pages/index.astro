---
import Base from '../layouts/Base.astro';
import About from '../components/About.astro';
import Hero from '../components/Hero.astro';
import NextStop from '../components/NextStop.astro';
import Projects from '../components/Projects.astro';
import RouteSpine from '../components/RouteSpine.astro';
import SkillsFilter from '../components/SkillsFilter.astro';
import TopBar from '../components/TopBar.astro';
---
<Base
  title="Clive Rafiq, backend engineer"
  description="Backend engineer and Computer Systems Engineering student at ASU, shipping production systems from Jakarta to New York."
>
  <TopBar />
  <main>
    <div class="wrap">
      <Hero />
      <About />
      <RouteSpine />
    </div>
    <Projects />
    <div class="wrap">
      <SkillsFilter />
      <NextStop />
    </div>
  </main>
</Base>
