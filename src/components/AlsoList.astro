---
import { also } from '../data/work';
---
<section id="also" data-also aria-labelledby="also-title">
  <h2 id="also-title">Also</h2>
  <ul class="also">
    {also.map(item => (
      <li>
        <span class="name">{item.name}</span>
        <span class="dates">{item.dates}</span>
        <span class="line">{item.line}</span>
        {item.link && <a href={item.link.href}>{item.link.label}</a>}
      </li>
    ))}
  </ul>
</section>

<style>
  section { padding-block: 64px; }
  h2 {
    margin: 0;
    font: 800 48px/1 'Bricolage Grotesque', system-ui, sans-serif;
    letter-spacing: -0.03em;
  }
  @media (max-width: 899px) { h2 { font-size: 34px; } }
  .also { list-style: none; margin: 32px 0 0; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    max-width: 60ch;
    padding-block: 16px;
    border-top: 1px solid var(--hairline);
    font: 400 17px/1.5 'Geist', system-ui, sans-serif;
  }
  .name { font: 800 20px/1.2 'Bricolage Grotesque', system-ui, sans-serif; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .dates { font-size: 15px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .line { grid-column: 1 / -1; }
  a { grid-column: 1 / -1; justify-self: start; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; font-weight: 500; font-size: 15px; }
</style>
