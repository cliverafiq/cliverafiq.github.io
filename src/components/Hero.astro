---
import WorldRoute from './WorldRoute.astro';
import { profile } from '../data/profile';
---
<header id="top" class="hero" data-hero>
  <h1 class="visually-hidden">{profile.name}</h1>
  <p class="headline">{profile.headline}</p>
  <WorldRoute />
  <p class="hero-links">
    <a class:list={['button', 'primary']} href={profile.resumePath}>Resume</a>
    <a class="button" href={profile.github}>GitHub</a>
  </p>
</header>

<style>
  .hero {
    padding-block: 56px 72px;
  }
  .headline {
    max-width: 22ch;
    font-size: var(--t-headline);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
</style>
