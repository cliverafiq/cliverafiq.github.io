---
import { profile } from '../data/profile';
import { stops } from '../data/stops';
---
<nav class="topbar" aria-label="Route">
  <div class="bar wrap">
    <a class="home" href="#top">{profile.name}</a>
    <div class="where">
      <ol class="mini" data-topbar-route>
        {stops.map(stop => (
          <li>
            <a href={`#stop-${stop.id}`} aria-label={stop.city}><span class="dot" aria-hidden="true"></span></a>
          </li>
        ))}
      </ol>
      <span class="current" data-current-city></span>
    </div>
  </div>
</nav>

<script>
  import { initRouteProgress } from '../scripts/route-progress';
  initRouteProgress();
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-top: env(safe-area-inset-top, 0px);
    background: var(--page);
    border-bottom: 1px solid var(--hairline);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--bar);
  }
  .home {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .where {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mini {
    position: relative;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mini::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 14px;
    right: 14px;
    height: 2px;
    margin-top: -1px;
    background: var(--track);
  }
  .mini a {
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 2px solid var(--route);
    background: var(--page);
  }
  .mini a[aria-current] .dot {
    background: var(--route);
  }
  .current {
    min-width: 9ch;
    font-size: var(--t-label);
    color: var(--muted);
  }
  /* Shown by the script once the hero has scrolled away. */
  .mini:not([data-show]),
  .mini:not([data-show]) + .current {
    visibility: hidden;
  }
  @media (max-width: 420px) {
    .current { display: none; }
  }
</style>
