---
import { stops } from '../data/stops';
import { MAP, dotsPath, landDots, project, routePath } from '../lib/geo';

const points = stops.map(stop => project(stop.lon, stop.lat));
const land = dotsPath(landDots());
const route = routePath(points);
const end = points[points.length - 1];
const pct = (n: number) => `${(n * 100).toFixed(2)}%`;

// Where each label sits relative to its stop, so neighbouring cities never collide.
const placement: Record<string, string> = { jakarta: 'right', tempe: 'below', 'west-lafayette': 'below-left', 'new-york': 'above' };
// When the line reaches each stop during the 2.6 s draw (the Pacific hop takes most of it).
const arrival = (i: number) => [0.2, 2.0, 2.45, 2.7][i] ?? 2.7 + (i - 3) * 0.25;
---
<div class="world-route">
  <div class="map">
    <svg viewBox={`0 0 ${MAP.width} ${MAP.height}`} aria-hidden="true">
      <path class="land" d={land} />
      <path class="route" d={route} pathLength="1" />
      <path class="next" d={`M${(end.x * MAP.width).toFixed(1)} ${(end.y * MAP.height).toFixed(1)} H${MAP.width - 8}`} />
      {points.map((p, i) => (
        <circle class="marker" cx={(p.x * MAP.width).toFixed(1)} cy={(p.y * MAP.height).toFixed(1)} r="9" style={`--d:${arrival(i)}s`} />
      ))}
    </svg>
    <ol class="top-route">
      {stops.map((stop, i) => (
        <li class={placement[stop.id] ?? 'below'} style={`--x:${pct(points[i].x)};--y:${pct(points[i].y)};--d:${arrival(i)}s`}>
          <a href={`#stop-${stop.id}`}><span class="city">{stop.city}</span> <span class="years">{stop.years}</span></a>
        </li>
      ))}
    </ol>
    <p class="next-label" style={`--y:${pct(end.y)}`}>Next: 2027</p>
  </div>
  <ul class="wins">
    {stops.map(stop => (
      <li><span class="city">{stop.city}</span> <span class="win">{stop.win}</span></li>
    ))}
  </ul>
</div>

<style>
  .map {
    position: relative;
    margin-top: 8px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .land {
    fill: none;
    stroke: var(--track);
    stroke-width: 3.6;
    stroke-linecap: round;
  }
  /* pathLength=1 lets the draw animation run from a hidden dash to a full one. */
  .route {
    fill: none;
    stroke: var(--route);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: route-draw 2.6s cubic-bezier(0.65, 0, 0.35, 1) 0.2s both;
  }
  .next {
    fill: none;
    stroke: var(--route);
    stroke-width: 4;
    stroke-dasharray: 8 9;
    animation: fade-in 0.4s ease-out 2.9s both;
  }
  .marker {
    fill: var(--page);
    stroke: var(--route);
    stroke-width: 4.5;
    animation: fade-in 0.35s ease-out var(--d) both;
  }
  .top-route {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .top-route li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    animation: fade-in 0.35s ease-out var(--d) both;
  }
  .top-route .right { transform: translate(16px, -50%); }
  .top-route .below { transform: translate(-50%, 16px); }
  .top-route .below-left { transform: translate(calc(-100% + 10px), 16px); }
  .top-route .above { transform: translate(-10px, calc(-100% - 16px)); }
  .top-route a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--page);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .top-route .city {
    font-size: var(--t-small);
    font-weight: 500;
  }
  .top-route .years {
    font-size: var(--t-label);
    color: var(--muted);
  }
  .top-route a:hover .city {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .next-label {
    position: absolute;
    right: 0;
    top: calc(var(--y) + 18px);
    font-size: var(--t-label);
    color: var(--route);
    animation: fade-in 0.4s ease-out 2.9s both;
  }
  .wins {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 40px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--hairline);
    list-style: none;
  }
  .wins .city {
    display: block;
    font-size: var(--t-label);
    color: var(--muted);
  }
  .wins .win {
    display: block;
    margin-top: 4px;
    font-size: var(--t-body);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .top-route .years { display: none; }
    .top-route .city { font-size: 13px; }
    .top-route a { padding: 2px 5px; }
    .top-route .right { transform: translate(10px, -50%); }
    .top-route .below { transform: translate(-50%, 10px); }
    .top-route .below-left { transform: translate(calc(-100% + 6px), 10px); }
    .top-route .above { transform: translate(-6px, calc(-100% - 10px)); }
    .next-label { display: none; }
    .wins { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  }
  @keyframes route-draw {
    from { stroke-dashoffset: 1; }
  }
  @keyframes fade-in {
    from { opacity: 0; }
  }
</style>
