---
import MiniRoute from './MiniRoute.astro';
import { categoryLabels, skills } from '../data/skills';
import { stops } from '../data/stops';
import type { SkillCategory } from '../data/types';

const categories = Object.entries(categoryLabels) as [SkillCategory, string][];
---
<section id="skills" class="skills-section" aria-labelledby="skills-title">
  <h2 id="skills-title">Skills</h2>
  <div class="filters" role="group" aria-label="Filter skills" hidden>
    <button type="button" data-filter="all" aria-pressed="true">All</button>
    {categories.map(([id, label]) => <button type="button" data-filter={id} aria-pressed="false">{label}</button>)}
  </div>
  <p class="legend">Dots follow the route: {stops.map(stop => stop.city).join(', ')}</p>
  <ul class="skills">
    {skills.map(skill => (
      <li data-category={skill.category}>
        <span class="skill">{skill.name}</span>
        <MiniRoute usedAt={skill.usedAt} />
      </li>
    ))}
  </ul>
</section>

<script>
  import { initSkillsFilter } from '../scripts/skills-filter';
  initSkillsFilter();
</script>

<style>
  .skills-section {
    padding-block: 64px;
  }
  h2 {
    margin-bottom: 24px;
  }
  .filters:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  button {
    padding: 6px 14px;
    border: 1px solid var(--track);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--t-label);
    cursor: pointer;
  }
  button[aria-pressed='true'] {
    border-color: var(--route);
    background: var(--route);
    color: var(--page);
  }
  .legend {
    margin-bottom: 8px;
    font-size: var(--t-label);
    color: var(--muted);
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skills li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 10px;
    border-top: 1px solid var(--hairline);
  }
  .skills li[hidden] {
    display: none;
  }
  .skill {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .skills { grid-template-columns: minmax(0, 1fr); }
  }
</style>
